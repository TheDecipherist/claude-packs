{
  "name": "@thedecipherist/claude-packs",
  "version": "0.15.0",
  "description": "Per-project Claude Code rules, lesson checks, hooks and skills for JUCE synths: realtime audio, DSP, Dawn GPU painter, Stellix. Installs into the project's own .claude/, never globally.",
  "type": "module",
  "bin": {
    "claude-packs": "bin/claude-packs.mjs"
  },
  "files": [
    "bin",
    "lib",
    "global",
    "prompts",
    "profiles",
    "packs",
    "configurations",
    "README.md",
    "CHANGELOG.md"
  ],
  "optionalDependencies": {
    "jscpd": "5.4.2"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import ./test/fresh-tmp.mjs --test test/*.test.mjs",
    "test:changed": "node scripts/test-changed.mjs"
  },
  "license": "MIT",
  "private": true
}
