{
  "name": "stellix",
  "version": "1.0.0",
  "description": "Stellix spec laws: the world, determinism, generated reset, no shipped images.",
  "type": "stock",
  "author": "Tim Clausen",
  "license": "MIT",
  "homepage": "https://github.com/TheDecipherist/claude-packs",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheDecipherist/claude-packs.git",
    "directory": "packs/stellix"
  },
  "keywords": [
    "synth"
  ],
  "engines": {
    "claude-packs": ">=0.19.0"
  },
  "folders": {
    "world": {
      "path": "src/world",
      "purpose": "the world: coordinates, travellers, hits, pushes, the snapshot writer, the seeded generator, world maths"
    },
    "records": {
      "path": "records",
      "purpose": "layout and state records: every piece of state declared once with its starting value"
    }
  },
  "concepts": {
    "world": [
      "world"
    ],
    "records": [
      "records"
    ],
    "params": [
      "records"
    ]
  },
  "skillsIn": null,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-shipped-images.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "files": {
    "seeded_random": "src/world/seeded_random.h",
    "world_math": "src/world/world_math.h",
    "snapshot": "src/world/snapshot.h"
  }
}
