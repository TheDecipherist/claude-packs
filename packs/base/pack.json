{
  "name": "base",
  "version": "1.0.0",
  "description": "Universal engineering every configuration gets: the git laws, the line limit, the folder and placement laws, the shape law (shape-law, brief-guard, making, making-check), once-only, lesson checks, secrets-guard and the untrusted-content boundary.",
  "type": "stock",
  "author": "Tim Clausen",
  "license": "MIT",
  "homepage": "https://github.com/TheDecipherist/claude-packs",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheDecipherist/claude-packs.git",
    "directory": "packs/base"
  },
  "keywords": [
    "universal",
    "git",
    "hooks"
  ],
  "engines": {
    "claude-packs": ">=0.19.0"
  },
  "concepts": {
    "cpp": [
      "src/**/*.cpp",
      "src/**/*.h",
      "src/**/*.hpp",
      "src/**/*.mm",
      "tests/**/*.cpp",
      "tests/**/*.h"
    ],
    "tests": [
      "tests"
    ],
    "build": [
      "**/CMakeLists.txt",
      "**/*.cmake",
      "CMakePresets.json"
    ],
    "claude": [
      ".claude/skills/**",
      "**/.claude/skills/**",
      ".claude/agents/**",
      ".claude/rules/**"
    ],
    "notes": [
      "bugs.md",
      "workflow-bugs.md",
      "**/known-issues*.md",
      "docs/**/*.md"
    ],
    "docs-folder": [
      "docs"
    ],
    "tooling": [
      "tools/**",
      ".claude/hooks/**",
      ".claude/settings.json"
    ],
    "plan": [
      "build.md",
      "**/build.md"
    ],
    "copy-trees": [
      "kind:copy",
      ".claude/layout.json"
    ],
    "js": [
      "src/**/*.{js,mjs,cjs,jsx,ts,tsx}",
      "tests/**/*.{js,mjs,cjs,ts,tsx}",
      "test/**/*.{js,mjs,cjs,ts,tsx}"
    ]
  },
  "skillsIn": null,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lesson-checks.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/file-size-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/placement-law.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/folder-law.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/shape-law.mjs\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/brief-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/once-only.mjs\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/secrets-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/untrusted-boundary.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-once.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/brief-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/suite-once.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/making-check.mjs\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/making.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "onByDefault": [
    "hooks/shape-law.mjs",
    "hooks/brief-guard.mjs",
    "hooks/once-only.mjs",
    "hooks/making.mjs",
    "hooks/making-check.mjs",
    "hooks/run-hooks.mjs"
  ],
  "optIn": []
}
