// PreToolUse (Write|Edit|MultiEdit|NotebookEdit|Bash): code stays small in every direction, not only in lines per file. Measured on a real repo: 21% of
// code lines held two or more statements, so a file "under 300 lines" was 500, and one function held 140 statements in 70 lines. A write is refused when it adds
// a line too wide or packed, a function too long, or a function with too many parameters. What already stands is judged only if it gets worse.
// `layout.json` "guards": { "codeShape": { "maxLineChars", "maxStatementsPerLine", "maxFunctionStatements", "maxParameters" } } changes a limit.
// A judge on the hook contract (typescript order W4). `--selftest` proves it.
import { extname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { statementsOf } from './lib/code-shapes.mts';
import { isContent } from './lib/content.mts';
import { TESTS } from './lib/elements.mts';
import { functionsOf } from './lib/function-shapes.mts';
import type { FunctionShape } from './lib/function-shapes.mts';
import { matchesAny } from './lib/glob.mts';
import { isMain, runAsHook } from './lib/hook-log.mts';
import { languageOf } from './lib/languages.mts';
import type { Language } from './lib/languages.mts';
import { oneOffLines } from './lib/repo-index.mts';
import { bashOf, editOf, runHook, scratchProject, snapshot, verdicts, writeOf, writtenSince } from './lib/selftest.mts';
import type { WorktreeCase } from './lib/selftest.mts';
import type { FileWrite, Hook } from './lib/types.d.mts';
import { layoutOfWrite } from './lib/write-layout.mts';
import { judgeVerdict } from './lib/writes.mts';

interface Limits { maxLineChars: number; maxStatementsPerLine: number; maxFunctionStatements: number; maxParameters: number }
const LIMITS: Limits = { maxLineChars: 120, maxStatementsPerLine: 2, maxFunctionStatements: 50, maxParameters: 6 };
const GENERATED = /\b(?:auto-?generated|generated by|do not edit|@generated)\b/i;

// Lines this write adds, by number: a line that was already there is not its fault.
function addedLines(before: string, after: string): number[] {
  const left = before.split('\n').reduce((m, l) => m.set(l, (m.get(l) ?? 0) + 1), new Map<string, number>());
  return after.split('\n').flatMap((l, i) => { const n = left.get(l) ?? 0; left.set(l, n - 1); return n > 0 ? [] : [i + 1]; });
}

const PACKED_WHY = 'One statement a line: a diff, a breakpoint and a coverage line then mean something, and the file\'s size is true.';

// Every line at fault at once: one a refusal cost a whole resend for each, the largest cost the kit added on the MPX 500 (37 of its 132 refusals).
function lineFaults(lang: Language, text: string, added: readonly number[], off: ReadonlySet<number>, limits: Limits): string[] {
  const code = lang.blank(text).split('\n');
  const perLine = statementsOf(text, lang).reduce((m, s) => m.set(s.line, (m.get(s.line) ?? 0) + 1), new Map<number, number>());
  const faults: string[] = [];
  for (const n of added.filter((x) => !off.has(x))) {
    const width = code[n - 1]?.trimEnd().length ?? 0;
    if (width > limits.maxLineChars) faults.push(`line ${n} is ${width} columns of code (limit ${limits.maxLineChars}). Break it where it reads.`);
    if ((perLine.get(n) ?? 0) > limits.maxStatementsPerLine) faults.push(`line ${n} holds ${perLine.get(n)} statements. ${PACKED_WHY}`);
  }
  return faults;
}

function functionFault(before: readonly FunctionShape[], after: readonly FunctionShape[], off: ReadonlySet<number>, limits: Limits): string | null {
  const was = new Map(before.map((f) => [f.name, f]));
  for (const f of after.filter((x) => !off.has(x.line))) {
    const old = was.get(f.name);
    if (f.statements > limits.maxFunctionStatements && f.statements > (old?.statements ?? 0)) {
      return `${f.name} (line ${f.line}) holds ${f.statements} statements (limit ${limits.maxFunctionStatements}). ` +
        'A function that does many things cannot be tested in parts: split it by what it does.';
    }
    if (f.params > limits.maxParameters && f.params > (old?.params ?? 0)) {
      return `${f.name} (line ${f.line}) takes ${f.params} parameters (limit ${limits.maxParameters}). ` +
        'Pass one struct or object: positional arguments of one type get swapped and still compile.';
    }
  }
  return null;
}

/** The guard's own limits and exclusions in a layout's `guards.codeShape`. */
interface CodeShapeGuard extends Partial<Limits> { exclude?: readonly string[] }

function shapeFault(w: FileWrite, rel: string, guard: CodeShapeGuard, content: boolean): string | null {
  const ext = extname(w.path);
  const lang = languageOf(ext);
  if (!lang || w.op === 'delete' || w.after === null || matchesAny(rel, TESTS) || GENERATED.test(w.after.slice(0, 400))) return null;
  if (matchesAny(rel, guard.exclude ?? []) || content) return null;
  const limits: Limits = { ...LIMITS, ...guard };
  const before = w.before ?? '';
  const off = oneOffLines(w.after);
  const lines = lineFaults(lang, w.after, addedLines(before, w.after), off, limits);
  const faults = [...lines, functionFault(functionsOf(before, ext), functionsOf(w.after, ext), off, limits)].filter(Boolean);
  return faults.length ? `${faults.join('\n')}\nIf one truly must stay, say so above it: \`one-off: <reason>\`.\n` : null;
}

export const hook: Hook = (event, ctx) => judgeVerdict(event, {
  name: 'code-shape',
  write: (w, rel) => {
    const layout = layoutOfWrite(ctx, w.path);
    const guard = (layout.guards?.['codeShape'] ?? {}) as CodeShapeGuard;
    return shapeFault(w, rel, guard, isContent(rel, layout));
  },
}, ctx);

const PACKED = 'void f() {\n  a(); b(); c();\n}\n';
const writeAt = (file: string): Record<string, unknown> => ({ tool_name: 'Write', tool_input: { file_path: file, content: PACKED } });

/** The worktree's layout lifts the limit; main's does not. A file is judged by its own checkout's layout. */
export const worktreeCase: WorktreeCase = {
  files: { '{wt}/.claude/layout.json': JSON.stringify({ folders: {}, concepts: {}, guards: { codeShape: { maxStatementsPerLine: 9 } } }) },
  steps: [
    { label: 'packed statements in the worktree, whose layout allows 9', event: writeAt('{wt}/src/app/one.cpp'), want: 0 },
    { label: 'the same in the main checkout, whose limit is 2', event: writeAt('{here}/src/app/one.cpp'), want: 2 },
  ],
};

export function selftest(): number {
  const hookFile = fileURLToPath(import.meta.url);
  const body = (n: number): string => Array.from({ length: n }, (_, i) => `  total = total + step(${i});\n`).join('');
  const long = `void big() {\n${body(60)}}\n`;
  const layout = { folders: {}, concepts: {}, guards: { codeShape: { exclude: ['kept/**'] } } };
  const dir = scratchProject({ 'src/old.cpp': `void old() {\n${body(55)}}\n`, 'src/packed.h': 'void p() { a(); b(); c(); d(); }\n', 'kept/x.cpp': '// x\n' }, layout);
  const before = snapshot(dir);   // the project as the judge finds it: the rows below must leave it as it is
  const w = (file: string, content: string): number | null => runHook(hookFile, dir, writeOf(`${dir}/${file}`, content)).status;
  const wide = `int x = ${'a + '.repeat(40)}b;\n`;
  const pyBody = Array.from({ length: 60 }, (_, i) => `    total = step(${i})\n`).join('');
  const lambdas = 'void f()\n{\n    judge ("a", b, [&] { return g (1); }),\n    judge ("c", d, [&] { return g (2); }),\n}\n';
  const grow = (from: string, to: string, file = 'src/old.cpp'): number | null => runHook(hookFile, dir, editOf(`${dir}/${file}`, from, to)).status;
  const heredoc = "cat > src/h.cpp <<'EOF'\nvoid f() { a(); b(); c(); }\nEOF";
  const manyParams = 'void f(int a, int b, int c, int d, int e, int f, int g) {\n  run(a);\n}\n';
  return verdicts('code-shape', [
    ['a function over the limit', w('src/a.cpp', long), 2],
    ['the same in python', w('src/a.py', `def big(rows):\n${pyBody}`), 2],
    ['too many parameters', w('src/b.cpp', manyParams), 2],
    ['a self parameter is not counted', w('src/b.py', 'def f(self, a, b, c, d, e, g):\n    run(a)\n'), 0],
    ['packed statements', w('src/c.cpp', PACKED), 2],
    ['a Python set comprehension is one statement (KF-14)', w('src/s.py', 'left = {keep(row) for row in rows} - {drop(row) for row in rows}\n'), 0],
    ['a lambda in a list counts as in a call (KF-27)', w('src/l.cpp', lambdas), 0],
    ['a for header is one statement', w('src/d.cpp', 'void f() {\n  for (int i = 0; i < n; i++) total += v(i);\n}\n'), 0],
    ['a wide line', w('src/e.cpp', wide), 2],
    ['a wide comment is no code', w('src/f.cpp', `// ${'word '.repeat(50)}\nint x = 1;\n`), 0],
    ['an old long function, edited without growing', grow('step(3)', 'step(4)'), 0],
    ['an old long function that grows', grow('  total = total + step(3);\n', '  total = total + step(3);\n  total = total + step(99);\n'), 2],
    ['an old packed line that is edited', grow('void p()', 'void q()', 'src/packed.h'), 2],
    ['a marked one-off', w('src/g.cpp', `// one-off: the table is generated by hand\n${wide}`), 0],
    ['a test file', w('tests/x_test.cpp', long), 0],
    ['an excluded folder', w('kept/y.cpp', long), 0],
    ['a tutorial sample in a content folder', w('articles/guide/y.cpp', long), 0],
    ['a blog route is code', w('src/app/blog/page.cpp', long), 2],
    ['a heredoc that adds a packed line', runHook(hookFile, dir, bashOf(heredoc, dir)).status, 2],
    ['a judge writes no file (the write trap)', writtenSince(dir, before).join(','), ''],
  ]);
}

if (isMain(import.meta.url)) await runAsHook(import.meta.url, 'code-shape', hook, selftest);
