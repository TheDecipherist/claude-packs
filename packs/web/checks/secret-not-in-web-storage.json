{
  "id": "secret-not-in-web-storage",
  "why": "The key that makes the privacy claim true should not be readable by every third-party script on the page.",
  "rule": ".claude/rules/secrets-not-in-the-browser.md",
  "globs": [
    "**/*.tsx",
    "**/*.jsx",
    "**/client/**/*.ts"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "code": true,
  "pattern": "(?:local|session)Storage\\.setItem\\([^,\\n]+,\\s*\\w*(?:[kK]ey(?:Input)?|[tT]oken|[sS]ecret|[pP]assword)\\w*\\s*\\)",
  "bad": "localStorage.setItem(STORAGE_KEY, keyInput);",
  "good": "localStorage.setItem(THEME_KEY, theme);"
}
