{
  "id": "tw-no-raw-hex-in-markup",
  "why": "A hex colour in a page or component is a value outside the token system; it drifts and has no dark: pair. Declare it once in @theme and use the utility.",
  "rule": ".claude/rules/ui-primitives-one-module.md",
  "globs": [
    "**/*.tsx",
    "**/*.jsx"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/out/**",
    ".claude/**",
    "**/.claude/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test/**",
    "**/tests/**",
    "**/*.stories.*",
    "**/tokens*",
    "**/theme*",
    "**/components/ui/**",
    "**/email/**",
    "**/emails/**",
    "**/mail/**"
  ],
  "code": false,
  "pattern": "#[0-9a-fA-F]{6}\\b",
  "bad": "<div className=\"bg-[#1f2937]\">",
  "good": "<div className=\"bg-surface-2\">",
  "kind": "quality"
}
