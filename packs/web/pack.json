{
  "name": "web",
  "version": "1.0.0",
  "description": "Web UI (Next.js, HTML, CSS, Tailwind 4): accessibility, one primitives module, styles in stylesheets, performance, production build, client boundaries.",
  "type": "stock",
  "author": "Tim Clausen",
  "license": "MIT",
  "homepage": "https://github.com/TheDecipherist/claude-packs",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheDecipherist/claude-packs.git",
    "directory": "packs/web"
  },
  "keywords": [
    "nextjs",
    "react",
    "css"
  ],
  "engines": {
    "claude-packs": ">=0.19.0"
  },
  "folders": {},
  "concepts": {
    "markup": [
      "**/*.tsx",
      "**/*.jsx",
      "**/*.html",
      "**/*.vue",
      "**/*.svelte"
    ],
    "styles": [
      "**/*.css",
      "**/*.scss",
      "**/styles/**",
      "**/tailwind.config.*",
      "**/postcss.config.*"
    ],
    "pages": [
      "**/app/**/page.tsx",
      "**/app/**/layout.tsx",
      "**/app/**/template.tsx",
      "**/pages/**/*.tsx",
      "**/pages/**/*.jsx",
      "**/routes/**/*.tsx"
    ],
    "components": [
      "**/components/**",
      "**/client/**"
    ],
    "client": [
      "**/app/**",
      "**/components/**",
      "**/client/**",
      "**/public/**",
      "**/*.tsx",
      "**/*.jsx"
    ],
    "build-config": [
      "**/next.config.*",
      "**/webpack*.js",
      "**/webpack*.mjs",
      "**/webpack*.cjs",
      "**/webpack*.ts",
      "**/rollup.config.*",
      "**/esbuild*.js",
      "**/esbuild*.mjs",
      "**/index.html",
      "**/_document.tsx"
    ]
  },
  "skillsIn": null,
  "hooks": {}
}
