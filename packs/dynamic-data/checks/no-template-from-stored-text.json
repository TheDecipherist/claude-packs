{
  "id": "no-template-from-stored-text",
  "why": "A template engine fed from stored text makes template edit rights equal code execution. Render against a declared context, with no code in the template.",
  "rule": ".claude/rules/every-dynamic-surface-has-a-boundary.md",
  "globs": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "pattern": "\\b(?:_\\.template|ejs\\.render|ejs\\.compile|Handlebars\\.compile|nunjucks\\.renderString|pug\\.render|pug\\.compile)\\(\\s*(?!['\\\"`])",
  "bad": "const html = _.template(doc.body)(context);",
  "good": "const html = renderBlocks(doc.blocks, context);\nconst tpl = _.template('<b>fixed</b>');",
  "kind": "security"
}
