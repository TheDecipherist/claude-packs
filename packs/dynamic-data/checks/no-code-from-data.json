{
  "id": "no-code-from-data",
  "why": "Text run as code turns a stored value or a request into code execution. Conditions belong in a closed language that nothing executes.",
  "rule": ".claude/rules/every-dynamic-surface-has-a-boundary.md",
  "globs": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/data/**"
  ],
  "pattern": "\\bnew\\s+Function\\s*\\(|(?<![\\w.])eval\\s*\\(",
  "bad": "const filters = new Function(\"return [\" + req.query.filters + \"];\")();",
  "good": "const filters = FilterTree.parse(req.body.filters);",
  "kind": "security",
  "code": true
}
