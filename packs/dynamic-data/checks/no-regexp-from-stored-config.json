{
  "id": "no-regexp-from-stored-config",
  "why": "A pattern from stored config runs in the regex engine with no boundary, and a bad one hangs the process. Declare validation as checked data, compiled into the schema.",
  "rule": ".claude/rules/every-dynamic-surface-has-a-boundary.md",
  "globs": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "pattern": "\\bnew\\s+RegExp\\s*\\(\\s*[\\w.]*(?:config|field|definition|setting|rule|requirements?)\\w*\\.[\\w.]*",
  "bad": "const re = new RegExp(field.config.requirements, \"g\");",
  "good": "const schema = compileField(field);\nconst re = new RegExp(escapeRe(term));",
  "kind": "security"
}
