{
  "id": "active-sensing-no-pulse",
  "why": "Treating the whole real-time range as pulses reads active sensing as clock, and reports a nonsense tempo.",
  "rule": ".claude/rules/clock-is-a-pulse-stream.md",
  "globs": [
    "**/*.cpp",
    "**/*.cc",
    "**/*.h",
    "**/*.hpp",
    "**/*.mm"
  ],
  "exclude": [
    "**/build/**",
    "**/out/**",
    "**/_deps/**",
    "**/JUCE/**",
    "**/node_modules/**"
  ],
  "pattern": ">=\\s*0x[fF]8\\s*\\)\\s*\\{?\\s*(?:\\+\\+\\s*\\w+|\\w*(?:pulse|clock|tick)\\w*\\s*(?:\\+\\+|\\+=|\\())",
  "bad": "if (b >= 0xF8) ++pulses;",
  "good": "if (b == 0xF8) ++pulses;",
  "flags": "i",
  "code": true
}
