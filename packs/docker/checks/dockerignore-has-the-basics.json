{
  "id": "dockerignore-has-the-basics",
  "why": "Without node_modules, .git, .env and dist in .dockerignore the build context is huge and the host's node_modules, secrets and stale builds land in the image.",
  "rule": ".claude/rules/dockerfile-production.md",
  "globs": [
    "**/.dockerignore"
  ],
  "code": false,
  "flags": "m",
  "mode": "needs",
  "pattern": "[\\s\\S]",
  "needs": [
    "^node_modules",
    "^\\.git\\b",
    "^\\.env",
    "^dist\\b",
    "^coverage\\b"
  ],
  "bad": "node_modules\n",
  "good": "node_modules\n.git\n.env*\ndist\ncoverage\n.claude\n"
}
