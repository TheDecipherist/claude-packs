{
  "id": "compose-no-plaintext-secret",
  "why": "A password, token or key as a literal in compose `environment:` is readable in the file, in `docker inspect` and in the repo. Use ${VAR} substitution, env_file, or Docker secrets.",
  "rule": ".claude/rules/compose-swarm-safe.md",
  "concepts": [
    "compose"
  ],
  "code": false,
  "flags": "m",
  "pattern": "^\\s+-?\\s*[A-Z0-9_]*(?:PASSWORD|PASSWD|SECRET|API_?KEY|TOKEN|PRIVATE_KEY|ACCESS_KEY|MONGODB_URI)[A-Z0-9_]*\\s*[:=]\\s*(?!\\$\\{?\\w)(?!['\\\"]?\\$)['\\\"]?[^\\s'\\\"$][^\\n]*",
  "bad": "      MONGO_INITDB_ROOT_PASSWORD: hunter2\n      - API_TOKEN=abc123",
  "good": "      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_ROOT_PASSWORD}\n      - API_TOKEN=${API_TOKEN:?set it}\n    secrets: [mongo_root_password]"
}
