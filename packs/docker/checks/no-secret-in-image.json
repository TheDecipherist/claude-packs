{
  "id": "no-secret-in-image",
  "why": "ENV/ARG values live in image layers and show in `docker history`. Build secrets use RUN --mount=type=secret; runtime secrets are injected at run time.",
  "rule": ".claude/rules/dockerfile-production.md",
  "concepts": [
    "dockerfile"
  ],
  "code": false,
  "flags": "mi",
  "pattern": "^\\s*(ENV|ARG)\\s+\\w*(SECRET|PASSWORD|PASSWD|TOKEN|API_KEY|APIKEY|PRIVATE_KEY|MONGODB_URI|DATABASE_URL)\\w*\\s*=?\\s*\\S",
  "bad": "ENV MONGODB_URI=mongodb+srv://x\nARG NPM_TOKEN",
  "good": "RUN --mount=type=secret,id=npmrc,target=/root/.npmrc npm ci\nENV NODE_ENV=production"
}
