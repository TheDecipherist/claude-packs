{
  "id": "secret-on-argv",
  "why": "A command line is visible to everyone on the box.",
  "rule": ".claude/rules/root-on-other-machines.md",
  "code": false,
  "globs": [
    "**/*.ts",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.go"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "pattern": "['\"]-p['\"]\\s*,\\s*\\w*(?:pass|pwd)\\w*|--password[= ]\\$|\\bpwd:\\s*\\\\?\"\\$\\{|PASSWORD '\\$\\{|--api-key\\s+'?\\$\\{",
  "bad": "await exec(id, ['mongosh', '-u', 'admin', '-p', adminPass]);",
  "good": "await exec(id, ['mongosh', '--file', '/run/secrets/init.js']);",
  "flags": "i",
  "kind": "security"
}
