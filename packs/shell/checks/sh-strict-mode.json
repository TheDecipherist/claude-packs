{
  "id": "sh-strict-mode",
  "why": "Without strict mode a failed step is ignored and the script carries on with bad state. A file only sourced is left out.",
  "rule": ".claude/rules/shell-strict-and-quoted.md",
  "concepts": [
    "shell"
  ],
  "globs": [],
  "exclude": [
    "**/lib/**",
    "**/*.lib.sh",
    "**/node_modules/**"
  ],
  "pattern": "^\\s*set\\s+-\\w*e",
  "flags": "m",
  "bad": "#!/usr/bin/env bash\nrm old\necho done",
  "good": "#!/usr/bin/env bash\nset -euo pipefail\nrm old",
  "mode": "require"
}
