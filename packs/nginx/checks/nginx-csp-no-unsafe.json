{
  "id": "nginx-csp-no-unsafe",
  "why": "'unsafe-inline' / 'unsafe-eval' make the CSP decorative. Use a nonce or a hash for the one inline script that needs it.",
  "rule": ".claude/rules/nginx-production.md",
  "concepts": [
    "nginx-conf"
  ],
  "exclude": [
    "**/node_modules/**"
  ],
  "code": false,
  "pattern": "'unsafe-(?:inline|eval)'",
  "bad": "add_header Content-Security-Policy \"script-src 'self' 'unsafe-inline'\" always;",
  "good": "add_header Content-Security-Policy \"script-src 'self' 'nonce-$request_id'; object-src 'none'; base-uri 'self'\" always;"
}
