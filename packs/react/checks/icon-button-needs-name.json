{
  "id": "icon-button-needs-name",
  "why": "A button with only an icon has no name for anyone who cannot see it.",
  "rule": ".claude/rules/react-accessible-controls.md",
  "globs": [
    "**/*.tsx",
    "**/*.jsx"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "strings": true,
  "pattern": "<button\\b(?![^>]*(?:aria-label|title=))[^>]*>\\s*<[A-Z]\\w*\\b[^>]*/>\\s*</button>",
  "bad": "<button onClick={f}><X className=\"w-4\" /></button>",
  "good": "<button aria-label=\"Close\" onClick={f}><X /></button>"
}
