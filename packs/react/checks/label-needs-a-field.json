{
  "id": "label-needs-a-field",
  "why": "A label tied to no field neither names it nor focuses it on a click.",
  "rule": ".claude/rules/react-accessible-controls.md",
  "globs": [
    "**/*.tsx",
    "**/*.jsx"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "strings": true,
  "pattern": "<label\\b(?![^>]*htmlFor)[^>]*>[^<]*</label>",
  "bad": "<label className=\"x\">Email</label><input />",
  "good": "<label htmlFor=\"e\">Email</label><input id=\"e\" />"
}
