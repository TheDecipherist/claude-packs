{
  "id": "cpp-no-mutable-global",
  "why": "A mutable global can be written by anything, from any thread, in any order. Own it in a class and pass it in.",
  "rule": ".claude/rules/cpp-thread-contracts-are-code.md",
  "concepts": [
    "cpp"
  ],
  "globs": [],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/probes/**",
    "**/build/**"
  ],
  "code": true,
  "pattern": "^(?:inline[ \\t]+|static[ \\t]+)?(?!const\\b|constexpr\\b|constinit\\b|using\\b|typedef\\b|template\\b|namespace\\b|class\\b|struct\\b|enum\\b|union\\b|return\\b|extern\\b|public\\b|private\\b|protected\\b|friend\\b|thread_local\\b|std::atomic\\b|std::mutex\\b|std::recursive_mutex\\b|std::once_flag\\b|void\\b|else\\b|goto\\b|delete\\b|throw\\b|case\\b)[A-Za-z_][\\w:]*(?:<[^;()\\n]*>)?[ \\t*&]+[A-Za-z_]\\w*[ \\t]*(?:\\[[^\\]\\n]*\\][ \\t]*)*(?:=(?!=)|\\{[^}\\n]*\\}[ \\t]*;|;)",
  "bad": "int gCount = 0;\nstd::vector<Item> gItems;\ninline bool useOldLayout = false;\nSettings gNow;",
  "good": "const int kMax = 4;\nstd::atomic<int> gHits { 0 };\nstd::mutex gLock;\nint f();",
  "flags": "m"
}
