{
  "id": "hook-command-no-pipe",
  "why": "A piped command exits with the pipe's last command, so a hook's exit 2 is lost.",
  "rule": ".claude/rules/a-refusal-is-exit-2.md",
  "code": false,
  "concepts": [
    "hook-config"
  ],
  "globs": [],
  "exclude": [
    "**/node_modules/**",
    "**/*.test.*"
  ],
  "pattern": "\"command\":\\s*\"[^\"\\n]*\\.(?:mjs|py|sh|js)[^\"\\n]*\\s\\|\\s",
  "bad": "{ \"command\": \"node .claude/hooks/guard.mjs | tee /tmp/log\" }\n",
  "good": "{ \"command\": \"node .claude/hooks/guard.mjs\" }\n"
}
