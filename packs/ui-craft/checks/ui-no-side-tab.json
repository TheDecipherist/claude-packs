{
  "id": "ui-no-side-tab",
  "why": "A thick coloured border down one side of a card is the most recognizable generated-UI tell. Use a tone step, or nothing.",
  "rule": ".claude/rules/no-generated-look.md",
  "code": false,
  "concepts": [
    "ui-markup"
  ],
  "globs": [],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    ".claude/**",
    "**/.claude/**",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "pattern": "\\bborder-l-(?:[2-9]|\\[[2-9]px\\])\\s+border-(?!transparent)[\\w-]+",
  "bad": "<div className=\"border-l-4 border-blue-500 p-4\" />\n",
  "good": "<div className=\"bg-surface-2 p-4\" />\n"
}
