{
  "id": "ui-no-bounce-easing",
  "why": "Bounce and elastic easing read dated. Real things decelerate smoothly.",
  "rule": ".claude/rules/motion-is-rare.md",
  "concepts": [
    "ui-markup",
    "ui-styles"
  ],
  "globs": [],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    ".claude/**",
    "**/.claude/**",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "pattern": "\\banimate-bounce\\b|cubic-bezier\\([^)\\n]*,\\s*(?:1\\.[1-9]|[2-9])\\d*[^)\\n]*\\)",
  "bad": "transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\n",
  "good": "transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);\n"
}
