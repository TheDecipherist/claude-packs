{
  "name": "gpu-painter",
  "version": "1.0.0",
  "description": "GPU-drawn UI on Dawn (Metal on Mac, Direct3D 12 on Windows), drawn natively: no OpenGL, no browser.",
  "type": "stock",
  "fits": ["synth-creator"],
  "requires": [],
  "tests": {
    "hooks/browser-guard.mts": ["test/hooks/gpu-painter/browser-guard.test.mts"]
  },
  "author": "claude-packs",
  "license": "MIT",
  "homepage": "https://github.com/TheDecipherist/claude-packs",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheDecipherist/claude-packs.git",
    "directory": "packs/gpu-painter"
  },
  "keywords": [
    "gpu",
    "dawn",
    "webgpu"
  ],
  "engines": {
    "claude-packs": ">=0.19.0"
  },
  "folders": {
    "painter": {
      "path": "src/painter",
      "purpose": "the GPU renderer: Dawn device, surfaces, passes, the snapshot reader"
    },
    "shaders": {
      "path": "src/painter/shaders",
      "purpose": "WGSL shaders"
    },
    "ui": {
      "path": "src/ui",
      "purpose": "input, gestures, camera, picking, undo (no drawing code)"
    }
  },
  "concepts": {
    "painter": [
      "painter"
    ],
    "shaders": [
      "shaders",
      "**/*.wgsl"
    ],
    "ui": [
      "ui"
    ]
  },
  "skillsIn": "painter",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/browser-guard.mjs\"",
            "role": "judge",
            "order": 170,
            "timeout": 15
          }
        ]
      }
    ]
  },
  "files": {
    "render_thread": "src/painter/render_thread.cpp"
  },
  "kinds": {
    "gpu-code": {
      "what": "anything that calls Dawn/WebGPU: device, surface, passes, the render thread",
      "in": "painter",
      "concepts": [
        "painter",
        "tests"
      ],
      "content": "\\b(wgpu::|wgpu[A-Z]\\w*\\s*\\(|WGPU[A-Z]\\w+)"
    },
    "shader": {
      "what": "WGSL shaders",
      "in": "shaders",
      "concepts": [
        "painter"
      ],
      "files": [
        "**/*.wgsl"
      ]
    },
    "ui-input": {
      "what": "input, gestures, camera, picking and undo (no drawing code)",
      "in": "ui"
    }
  }
}
