{
  "name": "reverse-engineering",
  "version": "1.0.0",
  "description": "Rebuilding a machine from its firmware, manuals and sound banks: two sources before naming anything, every law carries its source, a negative names what was scanned, every term of a sum is accounted for, and firmware stays out of git.",
  "type": "stock",
  "fits": ["base", "cpp", "synth-creator"],
  "requires": [],
  "tests": {
    "hooks/catalog-entry-exists.mts": ["test/hooks/reverse-engineering/catalog-entry-exists.test.mts"],
    "hooks/firmware-out-of-git.mts": ["test/hooks/reverse-engineering/firmware-out-of-git.test.mts"],
    "tools/byte-profile.mts": ["test/tools/reverse-engineering/byte-profile.test.mts"],
    "tools/dump-triage.mts": ["test/tools/reverse-engineering/dump-triage.test.mts"],
    "tools/lib/multi-find.mts": ["test/tools/reverse-engineering/multi-find.test.mts"],
    "tools/lib/names-find.mts": ["test/tools/reverse-engineering/names-sweep.test.mts"],
    "tools/lib/names-index.mts": ["test/tools/reverse-engineering/names-modes.test.mts"],
    "tools/lib/names-report.mts": ["test/tools/reverse-engineering/names-sweep.test.mts"],
    "tools/lib/names-runs.mts": ["test/tools/reverse-engineering/names-modes.test.mts"],
    "tools/lib/names-tables.mts": ["test/tools/reverse-engineering/names-sweep.test.mts"],
    "tools/lib/unwrap-proofs.mts": ["test/tools/reverse-engineering/names-modes.test.mts"],
    "tools/lib/unwrap.mts": ["test/tools/reverse-engineering/names-sweep.test.mts", "test/tools/reverse-engineering/names-modes.test.mts"],
    "tools/names-sweep.mts": ["test/tools/reverse-engineering/names-sweep.test.mts"],
    "tools/source-ledger.mts": ["test/tools/reverse-engineering/source-ledger.test.mts"]
  },
  "concepts": {},
  "folders": {},
  "skillsIn": null,
  "author": "claude-packs",
  "license": "MIT",
  "homepage": "https://github.com/TheDecipherist/claude-packs",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheDecipherist/claude-packs.git",
    "directory": "packs/reverse-engineering"
  },
  "keywords": [
    "reverse-engineering",
    "firmware"
  ],
  "engines": {
    "claude-packs": ">=0.28.0"
  },
  "optIn": ["hooks/catalog-entry-exists.mjs"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/catalog-entry-exists.mjs\"",
            "role": "judge",
            "order": 110,
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/firmware-out-of-git.mjs\"",
            "role": "judge",
            "order": 100,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
