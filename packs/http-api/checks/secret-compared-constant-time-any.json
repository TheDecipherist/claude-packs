{
  "id": "secret-compared-constant-time-any",
  "why": "Timing leaks are the smaller half; a short code with no per-account attempt count falls to a loop.",
  "rule": ".claude/rules/routes-validate-and-answer.md",
  "globs": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "strings": true,
  "pattern": "\\b\\w*(?:[Ss]ecret|SECRET|[Tt]oken|TOKEN|SERVICE_KEY|[Ss]erviceKey|[Aa]piKey|verificationCode|authHeader|provided)\\b\\s*[!=]==?\\s*(?!\\s*(?:undefined|null|''|\\\"\\\"))[`\\w]",
  "bad": "if (provided !== SERVICE_KEY) deny();\nif (user.verificationCode !== code) deny();",
  "good": "if (!safeEqual(provided, SERVICE_KEY)) deny();",
  "kind": "security"
}
