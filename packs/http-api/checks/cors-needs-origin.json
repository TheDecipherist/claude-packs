{
  "id": "cors-needs-origin",
  "why": "The default branch of a security decision must deny. CORS with credentials and no origin list trusts any site.",
  "rule": ".claude/rules/routes-scope-to-the-caller.md",
  "globs": [
    "**/*.ts",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "pattern": "\\bcors\\(\\s*(?:\\)|\\{\\s*credentials\\s*:\\s*true\\s*\\}\\s*\\)|\\{\\s*origin\\s*:\\s*(?:true|'\\*')\\b)",
  "bad": "app.use(cors({ credentials: true }));",
  "good": "app.use(cors({ origin: env.ALLOWED_ORIGINS, credentials: true }));",
  "kind": "security"
}
