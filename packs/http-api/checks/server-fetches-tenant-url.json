{
  "id": "server-fetches-tenant-url",
  "why": "The server has network reach its users do not: a URL a user gave goes through one fetch that refuses private, link-local and metadata ranges.",
  "rule": ".claude/rules/routes-validate-and-answer.md",
  "globs": [
    "**/*.ts",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/dashboard/**",
    "**/client/**",
    "**/public/**",
    "**/web/**"
  ],
  "pattern": "\\bfetch\\(\\s*(?:[\\w.]+\\.(?:url|uri|endpoint)|webhookUrl|targetUrl|callbackUrl)\\b|new\\s+MongoClient\\(\\s*(?:decrypted|user|input)\\w*|ldap\\.createClient\\(\\s*\\{\\s*url:\\s*config\\.",
  "bad": "await fetch(config.url, { method: 'POST', body });",
  "good": "await safeFetch(config.url, { method: 'POST', body });",
  "kind": "security"
}
