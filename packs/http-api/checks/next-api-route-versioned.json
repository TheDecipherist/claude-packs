{
  "id": "next-api-route-versioned",
  "why": "A route file outside a version folder is an unversioned API.",
  "rule": ".claude/rules/apis-are-versioned.md",
  "globs": [
    "**/app/api/**/route.ts",
    "**/app/api/**/route.js",
    "**/pages/api/**/*.ts"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/api/auth/**",
    "**/api/webhook*/**",
    "**/api/health/**",
    "**/api/cron/**",
    "**/app/api/v1/**",
    "**/app/api/v2/**",
    "**/app/api/v3/**",
    "**/app/api/v4/**",
    "**/app/api/v5/**",
    "**/app/api/v6/**",
    "**/app/api/v7/**",
    "**/app/api/v8/**",
    "**/app/api/v9/**",
    "**/pages/api/v1/**",
    "**/pages/api/v2/**",
    "**/pages/api/v3/**",
    "**/pages/api/v4/**",
    "**/pages/api/v5/**",
    "**/pages/api/v6/**",
    "**/pages/api/v7/**",
    "**/pages/api/v8/**",
    "**/pages/api/v9/**"
  ],
  "pattern": "^export\\s+(?:async\\s+)?(?:function|const)\\s+(?:GET|POST|PUT|PATCH|DELETE)\\b",
  "bad": "export async function GET(request) {\n  return json(rows);\n}",
  "good": "export const dynamic = 'force-dynamic';",
  "flags": "m"
}
