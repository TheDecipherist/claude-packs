{
  "id": "line-under-200-chars",
  "why": "A 200+ character line hides awaits inside ternaries inside object literals, or holds a 1,100-character description string. Split it, or move the text to a descriptions table.",
  "rule": ".claude/rules/stack-is-fastify-and-nextjs.md",
  "concepts": [
    "js"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    ".claude/**",
    "**/.claude/**",
    "**/*.min.*",
    "**/*.d.ts"
  ],
  "code": false,
  "flags": "m",
  "pattern": "^.{201,}$",
  "bad": "const x = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';",
  "good": "const x = 'short';"
}
