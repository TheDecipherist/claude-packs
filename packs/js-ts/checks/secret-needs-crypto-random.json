{
  "id": "secret-needs-crypto-random",
  "why": "`Math.random` output can be predicted from earlier output, so a key built from it is a guess, not a secret.",
  "rule": ".claude/rules/secrets-stay-secret.md",
  "concepts": [
    "js"
  ],
  "globs": [],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "code": true,
  "pattern": "function\\s+\\w*(?:Key|Token|Code|Secret|Password|Otp|Salt|Nonce)\\w*\\s*\\([^)]*\\)[^{]*\\{[^}]*?Math\\.random|\\b(?:key|token|code|secret|otp|password)\\w*\\s*(?:\\+?=|:)[^\\n]*Math\\.random",
  "bad": "function generateApiKey() { let k = ''; for (let i = 0; i < 32; i++) k += c[Math.floor(Math.random() * 62)]; return k; }",
  "good": "function generateApiKey() { return randomBytes(24).toString('base64url'); }"
}
