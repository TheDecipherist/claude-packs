{
  "id": "session-user-typed-once",
  "why": "A cast at each use means a renamed field compiles everywhere and fails at run time, in a security check.",
  "rule": ".claude/rules/types-once-at-the-edge.md",
  "concepts": [
    "js"
  ],
  "globs": [],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "code": true,
  "pattern": "\\(\\s*session\\??\\.user\\s+as\\s",
  "bad": "const role = (session.user as { role?: string }).role;",
  "good": "const role = session.user.role;"
}
