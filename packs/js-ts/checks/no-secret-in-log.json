{
  "id": "no-secret-in-log",
  "why": "Passwords in logs reach every log store, backup and support tool, and cannot be recalled.",
  "rule": ".claude/rules/secrets-stay-secret.md",
  "concepts": [
    "js"
  ],
  "globs": [],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "strings": true,
  "pattern": "\\b(?:console\\.\\w+|log(?:ger)?\\.\\w+)\\([^\\n]*(?:JSON\\.stringify\\(\\s*(?:req\\.body|request\\.body|body|credentials|payload)\\b|,\\s*(?:req\\.body|request\\.body|body|credentials)\\s*[,)]|\\b(?:password|passwd|apiKey|api_key|secret|authHeader|authorization)\\s*[,)])",
  "bad": "console.log('body', JSON.stringify(body));\nlogger.info('login', password);",
  "good": "console.log('body keys', Object.keys(body).length);\nlogger.info({ userId }, 'login ok');"
}
