{
  "id": "secret-has-no-fallback",
  "why": "A default secret is public in the source, and a deployment with a missing variable then runs with it and looks healthy.",
  "rule": ".claude/rules/secrets-stay-secret.md",
  "concepts": [
    "js"
  ],
  "globs": [],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "strings": true,
  "pattern": "process\\.env\\.\\w*(?:SECRET|TOKEN|PASSWORD|PASSWD|API_KEY|PRIVATE_KEY|SERVICE_KEY|CREDENTIAL)\\w*(?:\\s*(?:\\|\\||\\?\\?)\\s*process\\.env\\.\\w+)*\\s*(?:\\|\\||\\?\\?)\\s*['\\\"`]",
  "bad": "const s = process.env.TOKEN_SECRET || process.env.OTHER_SECRET || 'dev-secret';\nconst k = process.env.WEBHOOK_SECRET ?? '';",
  "good": "const s = requireEnv('TOKEN_SECRET');"
}
