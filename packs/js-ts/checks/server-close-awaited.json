{
  "id": "server-close-awaited",
  "why": "A process that exits before server.close() finishes drops the requests in flight.",
  "rule": ".claude/rules/outbound-calls-have-a-limit.md",
  "globs": [
    "**/server.ts",
    "**/server.js",
    "**/server.mjs",
    "**/src/index.ts",
    "**/src/main.ts"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "code": true,
  "pattern": "(?<!await\\s)\\bserver\\.close\\(\\s*\\)\\s*;",
  "bad": "server.close();\nawait closeDb();",
  "good": "await new Promise((r) => server.close(r));\nawait closeDb();"
}
