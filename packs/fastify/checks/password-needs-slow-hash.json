{
  "id": "password-needs-slow-hash",
  "why": "A fast digest (md5, sha1, sha256) of a password falls to offline brute force at billions of guesses per second. argon2id or bcrypt (cost >= 12) with the library's own salt.",
  "rule": ".claude/rules/credentials-and-input.md",
  "concepts": [
    "routes"
  ],
  "globs": [
    "**/auth/**",
    "**/handlers/**",
    "**/users*"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    ".claude/**",
    "**/.claude/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test/**",
    "**/tests/**"
  ],
  "code": false,
  "flags": "i",
  "pattern": "createHash\\s*\\(\\s*['\\\"](?:md5|sha1|sha256|sha512)['\\\"]\\s*\\)[^;\\n]*(?:password|passwd|pwd)|(?:password|passwd)[^;\\n]*createHash\\s*\\(\\s*['\\\"](?:md5|sha1|sha256|sha512)['\\\"]",
  "bad": "const hash = createHash('sha256').update(password + salt).digest('hex');",
  "good": "const hash = await argon2.hash(password, { type: argon2.argon2id });"
}
