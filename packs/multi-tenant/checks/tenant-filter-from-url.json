{
  "id": "tenant-filter-from-url",
  "why": "A query that takes its key from the URL and carries no tenant key reads or writes any tenant.",
  "rule": ".claude/rules/no-role-crosses-a-tenant.md",
  "code": false,
  "globs": [
    "**/routes/**/*.ts",
    "**/routes/**/*.js",
    "**/app/api/**/route.ts",
    "**/*.go"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/*_test.go"
  ],
  "pattern": "\\b(?:queryOne|updateOne|deleteOne|updateMany|deleteMany|findOne|findOneAndUpdate)(?:<[^(]*?>)?\\(\\s*'[\\w-]+'\\s*,\\s*\\{(?:(?!company_id|tenant_id|org_id|account_id|\\.\\.\\.)[^{}])*(?:req\\.params|\\bslug\\b)(?:(?!company_id|tenant_id|org_id|account_id|\\.\\.\\.)[^{}])*\\}|\\.(?:FindOne|Find|UpdateOne|UpdateMany|DeleteOne|DeleteMany|ReplaceOne|FindOneAndUpdate|FindOneAndDelete|FindOneAndReplace|CountDocuments)\\(\\s*\\w+\\s*,\\s*bson\\.[MD]\\{(?:(?!company_id|tenant_id|org_id|account_id|CompanyID|TenantID|OrgID|AccountID)[^{}]|\\{(?:(?!company_id|tenant_id|org_id|account_id|CompanyID|TenantID|OrgID|AccountID)[^{}])*\\})*(?:\\.PathValue\\(|chi\\.URLParam\\(|mux\\.Vars\\(|\\.Param\\(|\\.Params\\(|\\.URL\\.Query\\(\\)|\\.Query\\(\")(?:(?!company_id|tenant_id|org_id|account_id|CompanyID|TenantID|OrgID|AccountID)[^{}]|\\{(?:(?!company_id|tenant_id|org_id|account_id|CompanyID|TenantID|OrgID|AccountID)[^{}])*\\})*\\}|\\.(?:Query|QueryRow|Exec|QueryContext|QueryRowContext|ExecContext)\\(\\s*(?:\\w+\\s*,\\s*)?\"(?:(?!company_id|tenant_id|org_id|account_id|CompanyID|TenantID|OrgID|AccountID)[^\"\\n])*\\b(?:WHERE|where)\\b(?:(?!company_id|tenant_id|org_id|account_id|CompanyID|TenantID|OrgID|AccountID)[^\"\\n])*\"\\s*,[^\\n]*(?:\\.PathValue\\(|chi\\.URLParam\\(|mux\\.Vars\\(|\\.Param\\(|\\.Params\\(|\\.URL\\.Query\\(\\)|\\.Query\\(\")",
  "bad": "await deleteOne('companies', { slug: req.params.slug });",
  "good": "await deleteOne('companies', { slug: req.params.slug, company_id: user.company_id });",
  "kind": "security",
  "examples": [
    {
      "bad": "res, err := coll.DeleteOne(ctx, bson.M{\"slug\": r.PathValue(\"slug\")})",
      "good": "res, err := coll.DeleteOne(ctx, bson.M{\"company_id\": sess.CompanyID, \"slug\": r.PathValue(\"slug\")})"
    },
    {
      "bad": "row := db.QueryRowContext(ctx, \"SELECT name FROM sites WHERE id = $1\", r.PathValue(\"id\"))",
      "good": "row := db.QueryRowContext(ctx, \"SELECT name FROM sites WHERE tenant_id = $1 AND id = $2\", sess.TenantID, r.PathValue(\"id\"))"
    }
  ]
}
