{
  "_comment": "Stellix, tailored from docs/project.md (surveyed 2026-10-26, branch work/notes-hit, b41d77d). Complete: packs add no default folders. stage-guard is disabled: the house git-guard already refuses git add -A.",
  "complete": true,
  "folders": {
    "app": {
      "path": "lib/app",
      "purpose": "the standalone, processor, editor, player, demo and the one launch function (launch.cpp)"
    },
    "snapshot": {
      "path": "lib/snapshot",
      "purpose": "the one shared snapshot header the painter reads (header-only)"
    },
    "world": {
      "path": "lib/world",
      "purpose": "the world: travellers, strikes, rebounds, PULL, walls, the snapshot ring, State and the seeded RandomSource"
    },
    "engines": {
      "path": "lib/engines",
      "purpose": "SlotSound and Tabula 1's voice, copied and proved (src/tabula is read-only)"
    },
    "dsp": {
      "path": "lib/effects",
      "purpose": "effects and dynamics: delay, EQ, compressor, limiter (S11a-S11d)"
    },
    "painter": {
      "path": "lib/painter",
      "purpose": "everything drawn: scene, camera, card, GPU layer, shaders, the Painter facade"
    },
    "records": {
      "path": "data",
      "purpose": "data/records (fixed ids, moons) and data/bank (factory patches)"
    },
    "probes": {
      "path": "probes",
      "purpose": "probe executables, each with --selftest, and the shot program (pictures, benches)"
    },
    "plants": {
      "path": "tools/plants",
      "purpose": "planted-fault sources run by tools/plants.sh"
    },
    "docs": {
      "path": "docs",
      "purpose": "spec, delay spec, laws, licences, research, work order (plan and logs at the root: build.md, bugs.md, workflow-bugs.md)"
    },
    "tools": {
      "path": "tools",
      "purpose": "build.sh, step.py, gates/, hooks/, plants.sh and plants.d/, copy and compare tools"
    }
  },
  "concepts": {
    "cpp": [
      "lib/**/*.cpp",
      "lib/**/*.h",
      "lib/**/*.mm",
      "probes/**/*.cpp",
      "probes/**/*.h",
      "tools/plants/**/*.cpp"
    ],
    "audio": [
      "lib/app/src/processor.h",
      "lib/app/src/processor.cpp",
      "lib/app/src/sound.h",
      "lib/app/src/mixer.h",
