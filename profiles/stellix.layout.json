    "plants": "bash tools/plants.sh",
    "run": "bash tools/build.sh run",
    "step": "python3 tools/step.py status",
    "cpu-gate": "bash tools/build.sh test -R stellix.cpu_gate",
    "frame-bench": "stellix_shot --bench (built by `bash tools/build.sh build`)",
    "picture-gates": "bash tools/build.sh test -R '_gate'"
  },
  "siblings": [
    "../"
  ],
  "kinds": {
    "audio-entry": {
      "what": "processBlock and the processor, voices, sound and mixer",
      "in": "lib/app/src/processor.* (audio files) or lib/engines",
      "concepts": [
        "audio",
        "dsp",
        "tests"
      ],
      "content": "\\b(processBlock|renderNextBlock|getNextAudioBlock)\\s*\\("
    },
    "world": {
      "what": "travellers, strikes, rebounds, PULL, walls, the world step, the snapshot ring, seeded random",
      "in": "world"
    },
    "snapshot": {
      "what": "the one plain-data snapshot type the painter reads",
      "in": "snapshot"
    },
    "engine": {
      "what": "SlotSound and the copied Tabula voice (src/tabula is read-only)",
      "in": "engines"
    },
    "dsp-block": {
      "what": "effects and dynamics: delay, EQ, compressor, limiter",
      "in": "dsp"
    },
    "gpu-code": {
      "what": "anything that calls Dawn/WebGPU, the scene, camera, card, Painter facade",
      "in": "painter",
      "concepts": [
        "painter",
        "tests"
      ],
      "content": "\\b(wgpu::|wgpu[A-Z]\\w*\\s*\\(|WGPU[A-Z]\\w+)"
    },
    "shader": {
      "what": "WGSL shaders",
      "in": "painter",
      "concepts": [
        "painter"
      ],
      "files": [
        "**/*.wgsl"
      ]
    },
    "editor": {
      "what": "the editor, live view and UI wiring",
      "in": "app",
      "concepts": [
        "ui",
        "painter",
        "app",
        "tests"
      ],
      "content": "\\bvoid\\s+paint\\s*\\(\\s*(juce::)?Graphics\\b"
    },
    "records": {
      "what": "fixed-id records, moons, factory patches",
      "in": "records"
    },
    "probe": {
      "what": "a probe executable with --selftest, the shot program",
      "in": "probes"
    },
    "plant": {
      "what": "a planted-fault source for tools/plants.sh",
      "in": "plants"
    },
    "docs": {
      "what": "spec, laws, licences, research, work orders",
      "in": "docs",
      "concepts": [
        "docs-folder"
      ],
      "files": [
        "**/laws.md",
        "**/*-spec.md"
      ]
    },
    "tools": {
      "what": "build.sh, step.py, gates, hooks, copy and compare tools",
      "in": "tools"
    }
  }
