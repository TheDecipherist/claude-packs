      "**/.claude/settings.local.json"
    ],
    "ts": [
      "**/*.ts",
      "**/*.tsx"
    ],
    "js-tests": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.test.js",
      "**/*.test.mjs"
    ],
    "tsconfig": [
      "**/tsconfig*.json"
    ],
    "entry": [
      "**/server.ts",
      "**/server.js",
      "**/server.mjs",
      "**/src/index.ts",
      "**/src/index.js",
      "**/src/main.ts",
      "**/src/app.ts",
      "**/index.ts",
      "**/bin/**",
      "**/worker/**/index.*",
      "**/*.worker.ts",
      "**/lifecycle.*"
    ],
    "stored-text-ui": [
      "**/*.tsx",
      "**/*.jsx",
      "**/*.vue",
      "**/*.svelte",
      "**/ui/**/*.ts",
      "**/views/**/*.ts",
      "**/templates/**/*.ts",
      "**/render*.ts",
      "**/*.view.ts"
    ],
    "stored-text-renderer": [
      "**/stored-text.*"
    ],
    "ui-markup": [
      "**/*.tsx",
      "**/*.jsx",
      "**/*.html",
      "**/*.vue",
      "**/*.svelte",
      "**/ui/**/*.ts",
      "**/views/**/*.ts",
      "**/templates/**/*.ts",
      "**/*.view.ts"
    ],
    "ui-styles": [
      "**/*.css",
      "**/*.scss",
      "**/tailwind.config.*"
    ]
  },
  "kinds": {
    "schema": {
      "what": "a Zod schema (z.object) and the error contract",
      "in": "schemas",
      "concepts": [
        "schemas",
        "env"
      ],
      "content": "\\bz\\.(?:object|strictObject|looseObject)\\s*\\(",
      "extensions": [
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs"
      ]
    },
    "db-gateway": {
      "what": "the database driver and its one gateway",
      "in": "adapters",
      "concepts": [
        "adapters",
        "api-tests"
      ],
      "content": "\\bfrom\\s+['\"](?:mongodb|pg|mysql2|mongoose|@prisma/client|drizzle-orm[^'\"]*|ioredis|redis)['\"]",
      "extensions": [
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs"
      ]
    },
    "api-test": {
      "what": "API tests (inject(), never a bound port)",
      "in": "api-tests"
    }
  },
  "files": {},
  "protected": [],
  "disable": [],
  "enable": [],
  "commands": {},
  "siblings": [],
  "guards": {
    "git": {
      "house": true,
      "ghAuth": "cli",
      "trunkNeedsYes": true
    }
  },
  "ruleTests": {},
  "followFolders": true,
  "sourceFiles": "\\.(?:ts|tsx|mts|cts|js|jsx|mjs|cjs)$"
}
