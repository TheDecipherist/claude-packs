// wire-gen: writes the shared wire table out as `proxy/wire_gen.go` (typescript order W10b finding 1), and finds a second copy of one of
// its values in a file that should read the table instead. `node scripts/build-proxy.mts` runs `writeWireGo` before it hashes the Go
// sources, so the hash covers the generated file; `--check` there fails when the file is not this table's rendering.
//   node scripts/wire-gen.mts [--check]
import { existsSync, readFileSync, readdirSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { isMain } from '../packs/base/hooks/lib/hook-log.mts';
import { WIRE } from '../packs/base/hooks/lib/proxy-wire-table.mts';

const KIT = fileURLToPath(new URL('..', import.meta.url));
const q = (text: string): string => JSON.stringify(text);
const strings = (list: readonly string[]): string => `[]string{${list.map(q).join(', ')}}`;

/** The Go constants of the table: the file `proxy/wire_gen.go`. */
export function renderWireGo(): string {
  const w = WIRE;
  return `// Code generated by scripts/wire-gen.mts from packs/base/hooks/lib/proxy-wire-table.mts. DO NOT EDIT.
// The table is the one source of what the client and the resident runner share; change it there and run \`node scripts/build-proxy.mts\`.
package main

const (
	protocol      = ${w.protocol}
	maxStdin      = ${w.maxStdin}
	maxReply      = ${w.maxReply}
	maxSocketPath = ${w.maxSocketPath}
	wireName      = ${q(w.name)}
	tmpPrefix     = ${q(w.tmpPrefix)}
	suffixSocket  = ${q(w.suffix.socket)}
	suffixPid     = ${q(w.suffix.pid)}
	suffixLock    = ${q(w.suffix.lock)}
	envCache      = ${q(w.env.cache)}
	envRuntime    = ${q(w.env.runtime)}
	envProject    = ${q(w.env.project)}
	envDaemon     = ${q(w.env.daemon)}
	envHome       = ${q(w.env.home)}
	envPath       = ${q(w.env.path)}
	lockFile      = ${q(w.lockFile)}
	readyFd       = ${w.readyFd}
	flagServe     = ${q(w.flag.serve)}
	flagHooks     = ${q(w.flag.hooks)}
	flagReadyFd   = ${q(w.flag.readyFd)}
	flagProxy     = ${q(w.flag.proxy)}
	logFile       = ${q(w.hooksLog.file)}
	logEmpty      = ${q(w.hooksLog.empty)}
	logHook       = ${q(w.hooksLog.proxyHook)}
	logSource     = ${q(w.hooksLog.proxySource)}
)

// daemonKeeps is what a detached daemon carries of the caller's environment.
var daemonKeeps = ${strings(w.daemonKeeps)}

// logColumns is the order of a hooks.log line's columns; logOptional are those a line may leave off.
var (
	logColumns  = ${strings(w.hooksLog.columns)}
	logOptional = ${strings(w.hooksLog.optional)}
)
`;
}

const GENERATED = (root: string): string => join(root, 'proxy', 'wire_gen.go');

/** Writes `proxy/wire_gen.go` when it is not already this table's rendering. True when it changed. */
export function writeWireGo(root: string = KIT): boolean {
  const text = renderWireGo();
  const file = GENERATED(root);
  if (existsSync(file) && readFileSync(file, 'utf8') === text) return false;
  writeFileSync(file, text);
  return true;
}

/** Whether `proxy/wire_gen.go` is this table's rendering. */
export const wireGoCurrent = (root: string = KIT): boolean => existsSync(GENERATED(root)) && readFileSync(GENERATED(root), 'utf8') === renderWireGo();

/** The values the table owns that a second file must not write again: each is distinctive enough to mean the wire when it appears. */
export const OWNED: readonly string[] = [
  WIRE.env.daemon, WIRE.lockFile, WIRE.suffix.socket, WIRE.tmpPrefix, WIRE.hooksLog.file, WIRE.flag.readyFd, WIRE.flag.serve,
];

/** The files that speak the wire: every one reads the table, so none writes an owned value as a literal. The owners are left out. */
const PARTICIPANTS: readonly string[] = [
  'packs/base/hooks/lib/daemon-find.mts', 'packs/base/hooks/lib/proxy-client.mts', 'packs/base/hooks/resident.mts', 'packs/base/hooks/resident/lifecycle.mts',
  'packs/base/hooks/resident/sampling.mts', 'packs/base/hooks/resident/options.mts', 'packs/base/hooks/lib/hook-log.mts', 'packs/base/tools/statusline-daemon.mts',
  'lib/proxy-binary.mts', 'lib/daemon-cli.mts', 'lib/doctor-daemon.mts', 'scripts/build-proxy.mts',
];

export interface Copy { file: string; value: string; line: number }

/** The owned values written as a literal in a participant (a .mts of the list, or a hand-written .go of `proxy/` but `wire_gen.go` and tests). */
export function secondCopies(root: string = KIT, extra: readonly string[] = []): Copy[] {
  const goDir = join(root, 'proxy');
  const goFiles = existsSync(goDir) ? readdirSync(goDir).filter((n) => n.endsWith('.go') && !n.endsWith('_test.go') && n !== 'wire_gen.go' && n !== 'selftest.go').map((n) => join('proxy', n)) : [];
  const found: Copy[] = [];
  for (const file of [...PARTICIPANTS, ...goFiles, ...extra]) {
    const path = join(root, file);
    if (!existsSync(path)) continue;
    readFileSync(path, 'utf8').split('\n').forEach((text, i) => {
      if (/^\s*(\/\/|\*|\/\*)/.test(text)) return;   // a comment may name a value
      for (const value of OWNED) if (new RegExp(`${value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(?![A-Za-z0-9])`).test(text)) found.push({ file, value, line: i + 1 });
    });
  }
  return found;
}

if (isMain(import.meta.url)) {
  if (process.argv.includes('--check')) {
    const copies = secondCopies();
    for (const c of copies) console.error(`wire: ${c.file}:${c.line} writes ${c.value} itself; read it from proxy-wire-table.mts`);
    if (!wireGoCurrent()) console.error('wire: proxy/wire_gen.go is not the table\'s rendering; run node scripts/wire-gen.mts');
    process.exit(copies.length === 0 && wireGoCurrent() ? 0 : 1);
  }
  console.log(writeWireGo() ? 'wire: proxy/wire_gen.go written' : 'wire: proxy/wire_gen.go is current');
}
