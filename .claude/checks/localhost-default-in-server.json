{
  "id": "localhost-default-in-server",
  "why": "A production default of localhost sends real traffic nowhere, silently.",
  "rule": ".claude/rules/env-through-config.md",
  "globs": [],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/dashboard/**",
    "**/client/**",
    "**/public/**",
    "**/web/**",
    "**/scripts/**",
    "**/cli/**"
  ],
  "pattern": "(?:\\?\\?|\\|\\|)\\s*['\"`]https?://(?:localhost|127\\.0\\.0\\.1)",
  "bad": "const url = process.env.DASHBOARD_URL ?? 'http://localhost:3002';",
  "good": "const url = env.DASHBOARD_URL;",
  "concepts": [
    "js"
  ]
}
