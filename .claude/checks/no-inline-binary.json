{
  "id": "no-inline-binary",
  "why": "A base64 blob in a .ts file is a binary asset pretending to be source: unreviewable, undiffable, and loaded into memory on import. Serve the file as a file.",
  "rule": ".claude/rules/ts-source-stays-plain.md",
  "concepts": [
    "js"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    ".claude/**",
    "**/.claude/**"
  ],
  "code": false,
  "pattern": "[A-Za-z0-9+/=]{2000,}",
  "bad": "const PNG = '';",
  "good": "app.get('/logo.png', (_, r) => r.sendFile('logo.png'));"
}
