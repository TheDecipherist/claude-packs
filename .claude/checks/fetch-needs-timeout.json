{
  "id": "fetch-needs-timeout",
  "why": "One hung customer endpoint then holds a worker slot forever, and the outage looks like your bug.",
  "rule": ".claude/rules/outbound-calls-have-a-limit.md",
  "concepts": [
    "js"
  ],
  "globs": [],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/*.tsx",
    "**/*.jsx",
    "**/dashboard/**",
    "**/client/**",
    "**/public/**",
    "**/scripts/**"
  ],
  "code": true,
  "pattern": "\\bfetch\\((?![\\s\\S]{0,500}?\\bsignal\\b)",
  "bad": "await fetch(url, { method: 'POST' });",
  "good": "await fetch(url, { signal: AbortSignal.timeout(5000) });"
}
